{
  "schema_version": "0.1",
  "policy_path": "examples/policies/multi_agent_operations.json",
  "mapping_path": "examples/mcp/mapping.json",
  "trusted_identity_boundaries": [
    "identity.reference"
  ],
  "cases": [
    {
      "id": "allow",
      "proposal_path": "examples/mcp/proposals/browser-read.json",
      "expected": {
        "shadow_outcome": "evaluated",
        "normalization_outcome": "normalized",
        "disposition": "allow",
        "reason_codes": [
          "mcp.shadow.evaluated"
        ]
      }
    },
    {
      "id": "deny",
      "proposal_path": "examples/mcp/proposals/denied.json",
      "expected": {
        "shadow_outcome": "evaluated",
        "normalization_outcome": "normalized",
        "disposition": "deny",
        "reason_codes": [
          "mcp.shadow.evaluated"
        ]
      }
    },
    {
      "id": "require-approval",
      "proposal_path": "examples/mcp/proposals/email-send.json",
      "expected": {
        "shadow_outcome": "evaluated",
        "normalization_outcome": "normalized",
        "disposition": "require_approval",
        "reason_codes": [
          "mcp.shadow.evaluated"
        ]
      }
    },
    {
      "id": "approved-grant",
      "proposal_path": "examples/mcp/proposals/email-send.json",
      "grant_path": "examples/mcp/approval-grant.json",
      "state_path": "examples/approval_states/current.json",
      "expected": {
        "shadow_outcome": "evaluated",
        "normalization_outcome": "normalized",
        "disposition": "require_approval",
        "approval_outcome": "satisfied",
        "reason_codes": [
          "mcp.shadow.approval_verification_embedded",
          "mcp.shadow.evaluated"
        ]
      }
    },
    {
      "id": "spoofed-annotation",
      "proposal_path": "examples/mcp/proposals/browser-read-spoofed-annotations.json",
