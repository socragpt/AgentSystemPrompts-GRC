    {
      "id": "stale-mapping",
      "proposal_path": "examples/mcp/proposals/browser-read.json",
      "mapping_mutation": {
        "operation": "replace",
        "path": "/mapping/review_at",
        "value": "2026-08-20T00:00:00Z"
      },
      "expected": {
        "shadow_outcome": "normalization_rejected",
        "normalization_outcome": "rejected",
        "disposition": null,
        "reason_codes": [
          "mcp.mapping.stale"
        ]
      }
