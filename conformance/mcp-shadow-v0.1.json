        "disposition": null,
        "reason_codes": [
          "mcp.mapping.unknown_server"
        ]
      }
    },
    {
      "id": "ambiguous-mapping",
      "proposal_path": "examples/mcp/proposals/browser-read.json",
      "mapping_mutation": {
        "operation": "duplicate_entry",
        "entry_index": 0
      },
      "expected": {
        "shadow_outcome": "invalid_input",
        "normalization_outcome": "invalid_input",
        "disposition": null,
        "reason_codes": [
          "mcp.mapping.ambiguous_key"
        ]
      }
    },
    {
