      "expected": {
        "shadow_outcome": "evaluated",
        "normalization_outcome": "normalized",
        "disposition": "allow",
        "reason_codes": [
          "mcp.shadow.evaluated"
        ]
      }
    },
    {
      "id": "unmapped-tool",
      "proposal_path": "examples/mcp/proposals/unmapped-tool.json",
      "expected": {
        "shadow_outcome": "normalization_rejected",
        "normalization_outcome": "rejected",
        "disposition": null,
        "reason_codes": [
          "mcp.mapping.unmapped_tool"
        ]
      }
    },
    {
      "id": "unknown-server",
      "proposal_path": "examples/mcp/proposals/unknown-server.json",
