{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/socragpt/agent-governance-harness/schemas/proposed-evidence-record-v0.1.schema.json",
  "title": "Agent Governance Proposed Evidence Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "record_type",
    "proposal_only",
    "request",
    "principal",
    "action",
    "policy",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence\\.[0-9a-f]{64}$"
    },
    "record_type": {
      "const": "proposed_decision"
    },
    "proposal_only": {
      "const": true
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_sha256",
        "requested_at",
        "parameters_digest"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requested_at": {
          "$ref": "#/$defs/nullable_string"
        },
        "parameters_digest": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "trust_boundary_id",
        "assertion_id"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "trust_boundary_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "assertion_id": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_goal_id",
        "actor_id",
        "capability_id",
        "action",
        "resource_id"
      ],
      "properties": {
        "authorized_goal_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "actor_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "capability_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "action": {
          "$ref": "#/$defs/nullable_string"
        },
        "resource_id": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "policy": {
      "$ref": "#/$defs/policy_provenance"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "disposition",
        "valid_until",
        "reason_codes",
        "cited_control_ids",
        "effective_constraints",
        "approval_requirement_ids"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^decision\\.[0-9a-f]{64}$"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "valid_until": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "cited_control_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "effective_constraints": {
          "type": "object"
        },
        "approval_requirement_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "disposition": {
      "enum": [
        "allow",
        "deny",
        "require_approval"
      ]
    },
    "policy_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_version",
        "schema_version",
        "source_sha256"
      ],
      "properties": {
        "bundle_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "bundle_version": {
          "$ref": "#/$defs/nullable_string"
        },
        "schema_version": {
          "$ref": "#/$defs/nullable_string"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
