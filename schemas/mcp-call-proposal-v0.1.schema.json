{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/socragpt/agent-governance-harness/schemas/mcp-call-proposal-v0.1.schema.json",
  "title": "Agent Governance MCP Call Proposal v0.1",
  "description": "A caller-attributed proposal for one MCP tools/call. It contains no policy-facing classification fields and does not authorize dispatch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "server_id",
    "tool_name",
    "arguments",
    "principal",
    "actor_id",
    "authorized_goal_id",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "proposal_id": {
      "$ref": "#/$defs/identifier"
    },
    "server_id": {
      "$ref": "#/$defs/identifier"
    },
    "tool_name": {
      "$ref": "#/$defs/tool_name"
    },
    "arguments": {
      "type": "object"
    },
    "annotations": {
      "type": "object",
      "description": "Untrusted metadata retained only in the proposal artifact and never used as normalization authority."
    },
    "principal": {
      "$ref": "#/$defs/principal"
    },
    "actor_id": {
      "$ref": "#/$defs/identifier"
    },
    "authorized_goal_id": {
      "$ref": "#/$defs/identifier"
    },
    "requested_at": {
      "$ref": "#/$defs/timestamp"
    },
    "requested_constraints": {
      "$ref": "#/$defs/requested_constraints"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "authentication"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trust_boundary_id",
            "assertion_id",
            "authenticated_at",
            "expires_at"
          ],
          "properties": {
            "trust_boundary_id": {
              "$ref": "#/$defs/identifier"
            },
            "assertion_id": {
              "$ref": "#/$defs/identifier"
            },
            "authenticated_at": {
              "$ref": "#/$defs/timestamp"
            },
            "expires_at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      }
    },
    "requested_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cost",
        "max_duration_seconds",
        "max_action_count",
        "max_delegation_depth"
      ],
      "properties": {
        "max_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount_minor",
            "currency"
          ],
          "properties": {
            "amount_minor": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_action_count": {
          "type": "integer",
          "minimum": 1
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    }
  }
}
