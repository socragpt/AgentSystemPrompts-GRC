{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/socragpt/agent-governance-harness/schemas/approval-verification-state-v0.1.schema.json",
  "title": "Agent Governance Approval Verification State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verified_at",
    "trusted_request_identity_boundaries",
    "trusted_approver_identity_boundaries",
    "revoked_grant_ids",
    "consumed_grant_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "verified_at": {
      "$ref": "#/$defs/timestamp"
    },
    "trusted_request_identity_boundaries": {
      "$ref": "#/$defs/identifier_array"
    },
    "trusted_approver_identity_boundaries": {
      "$ref": "#/$defs/identifier_array"
    },
    "revoked_grant_ids": {
      "$ref": "#/$defs/identifier_array"
    },
    "consumed_grant_ids": {
      "$ref": "#/$defs/identifier_array"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "identifier_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
