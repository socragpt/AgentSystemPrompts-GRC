{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/socragpt/agent-governance-harness/schemas/mcp-adapter-mapping-v0.1.schema.json",
  "title": "Agent Governance MCP Adapter Mapping v0.1",
  "description": "A versioned exact-key mapping from caller-assigned MCP connections and tool names to framework-neutral Action Request classification fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mapping",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "mapping": {
      "$ref": "#/$defs/metadata"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identifier_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_uri",
        "revision",
        "authored_by",
        "approved_by"
      ],
      "properties": {
        "source_uri": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authored_by": {
          "$ref": "#/$defs/identifier_list"
        },
        "approved_by": {
          "$ref": "#/$defs/identifier_list"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "effective_at",
        "review_at",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "effective_at": {
          "$ref": "#/$defs/timestamp"
        },
        "review_at": {
          "$ref": "#/$defs/timestamp"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "requested_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cost",
        "max_duration_seconds",
        "max_action_count",
        "max_delegation_depth"
      ],
      "properties": {
        "max_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount_minor",
            "currency"
          ],
          "properties": {
            "amount_minor": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_action_count": {
          "type": "integer",
          "minimum": 1
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_id",
        "tool_name",
        "capability_id",
        "resource_id",
        "action",
        "channel_id",
        "data_classification",
        "expected_side_effects",
        "reversible"
      ],
      "properties": {
        "server_id": {
          "$ref": "#/$defs/identifier"
        },
        "tool_name": {
          "$ref": "#/$defs/tool_name"
        },
        "capability_id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/identifier"
        },
        "action": {
          "$ref": "#/$defs/identifier"
        },
        "channel_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "expected_side_effects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "create",
              "delete",
              "delegate",
              "external_communication",
              "read",
              "spend",
              "update"
            ]
          }
        },
        "reversible": {
          "type": "boolean"
        },
        "requested_constraints": {
          "$ref": "#/$defs/requested_constraints"
        }
      }
    }
  }
}
