{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/socragpt/agent-governance-harness/schemas/approval-grant-v0.1.schema.json",
  "title": "Agent Governance Approval Grant v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "approval_requirement_ids",
    "binding",
    "issued_at",
    "expires_at",
    "reuse_policy",
    "approvals"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "grant_id": {
      "$ref": "#/$defs/identifier"
    },
    "approval_requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "reuse_policy": {
      "const": "single_use"
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameters_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "policy_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_version",
        "schema_version",
        "source_sha256"
      ],
      "properties": {
        "bundle_id": {
          "$ref": "#/$defs/identifier"
        },
        "bundle_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "max_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount_minor",
        "currency"
      ],
      "properties": {
        "amount_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cost",
        "max_duration_seconds",
        "max_action_count",
        "max_delegation_depth",
        "allowed_data_classifications",
        "require_reversible"
      ],
      "properties": {
        "max_cost": {
          "$ref": "#/$defs/max_cost"
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_action_count": {
          "type": "integer",
          "minimum": 1
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "allowed_data_classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          }
        },
        "require_reversible": {
          "type": "boolean"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_sha256",
        "decision_id",
        "decision_disposition",
        "subject_actor_id",
        "capability_id",
        "resource_id",
        "parameters_digest",
        "policy",
        "scope"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^decision\\.[0-9a-f]{64}$"
        },
        "decision_disposition": {
          "const": "require_approval"
        },
        "subject_actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "capability_id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/identifier"
        },
        "parameters_digest": {
          "$ref": "#/$defs/parameters_digest"
        },
        "policy": {
          "$ref": "#/$defs/policy_provenance"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_boundary_id",
        "assertion_id",
        "authenticated_at",
        "expires_at"
      ],
      "properties": {
        "trust_boundary_id": {
          "$ref": "#/$defs/identifier"
        },
        "assertion_id": {
          "$ref": "#/$defs/identifier"
        },
        "authenticated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reference"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "reference": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "approver_actor_id",
        "approved_at",
        "identity",
        "rationale"
      ],
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/identifier"
        },
        "approver_actor_id": {
          "$ref": "#/$defs/identifier"
        },
        "approved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "rationale": {
          "$ref": "#/$defs/rationale"
        }
      }
    }
  }
}
